# AI-Powered Real-Time Student Attention and Engagement Monitoring System
# Environment configuration. Loaded automatically by config.py via python-dotenv.
# Edit these values to tune the system without touching source code.

# --- Database & Model file names ---
DATABASE_NAME=attention_monitor.db
MODEL_FILE_NAME=attention_model.joblib

# --- Webcam settings ---
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480

# --- Behavioural thresholds ---
EAR_BLINK_THRESHOLD=0.21
EAR_CONSEC_FRAMES=2
MAR_YAWN_THRESHOLD=0.60
MAR_CONSEC_FRAMES=8
HEAD_YAW_THRESHOLD=25.0
HEAD_PITCH_THRESHOLD=20.0

# --- Machine Learning settings ---
SYNTHETIC_SAMPLES_PER_CLASS=600

# --- Session / logging settings ---
LOGGING_INTERVAL_SECONDS=2.0
ASSUMED_FPS=20

# --- Streamlit dashboard settings ---
DASHBOARD_REFRESH_SECONDS=1.0
